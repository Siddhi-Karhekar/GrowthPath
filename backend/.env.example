# Copy this file to .env and fill in your own free-tier values.

# Supabase project settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-side only, never expose to the frontend
SUPABASE_JWT_SECRET=your-jwt-secret                # Settings -> API -> JWT Settings -> JWT Secret

# Groq (free tier) - https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b

# Embeddings run locally (no cost) - only change this if you want a different model
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

DOCUMENTS_BUCKET=documents
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173
